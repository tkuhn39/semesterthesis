{
  "$defs": {
    "GearKind": {
      "enum": [
        "external",
        "internal"
      ],
      "title": "GearKind",
      "type": "string"
    },
    "MaterialKind": {
      "description": "Steel and plastic branches are never mixed; every material-dependent function dispatches on this.",
      "enum": [
        "steel",
        "plastic"
      ],
      "title": "MaterialKind",
      "type": "string"
    },
    "MaterialRef": {
      "additionalProperties": false,
      "description": "Reference to a material record (name in the database or in the ``.ste`` file) with its kind.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/MaterialKind"
        },
        "name": {
          "description": "record name, e.g. '16MnCr5' or 'WST_PA66'",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "MaterialRef",
      "type": "object"
    },
    "QualitySystem": {
      "description": "Tolerance system a quality grade refers to; DIN 3962 Q7 and ISO 1328 Q7 are not the same.",
      "enum": [
        "DIN3962",
        "ISO1328"
      ],
      "title": "QualitySystem",
      "type": "string"
    },
    "SpanMeasurement": {
      "additionalProperties": false,
      "description": "Base tangent length W_k over k teeth (DIN 21773:2014 §7) as an alternative to x.",
      "properties": {
        "span_measurement_mm": {
          "description": "Span measurement",
          "designation": "Zahnweite über k Messzähne oder Messlücken",
          "designation_en": "Span measurement",
          "exclusiveMinimum": 0.0,
          "factor": false,
          "location": "§3.1 symbol list, p. 15",
          "quantity": "span_measurement",
          "source": "ISO21771:2014",
          "status": "verified",
          "stplus_key": "ZAHNWEITE",
          "symbol": "W_k",
          "title": "Span Measurement Mm",
          "type": "number",
          "unit": "mm"
        },
        "number_of_teeth_spanned": {
          "description": "Number of teeth spanned",
          "designation": "Anzahl der Zähne, Lücken oder Teilungen in einem Bereich (z. B. Messzähnezahl)",
          "designation_en": "Number of teeth spanned",
          "factor": false,
          "location": "§3.1 symbol list, p. 12",
          "minimum": 2,
          "quantity": "number_of_teeth_spanned",
          "source": "ISO21771:2014",
          "status": "verified",
          "stplus_key": "MESSZAEHNEZAHL",
          "symbol": "k",
          "title": "Number Of Teeth Spanned",
          "type": "integer",
          "unit": "-"
        }
      },
      "required": [
        "span_measurement_mm",
        "number_of_teeth_spanned"
      ],
      "title": "SpanMeasurement",
      "type": "object"
    },
    "ToolKind": {
      "enum": [
        "rack",
        "shaper",
        "profile"
      ],
      "title": "ToolKind",
      "type": "string"
    },
    "ToolProfile": {
      "additionalProperties": false,
      "description": "Tool reference profile of a rack-type tool (DIN ISO 21771:2014 §7.1; DIN 3972; DIN 867).\n\nHeight factors refer to the tool normal module ``m_n0``. ``normal_module_mm`` and\n``profile_angle_deg`` default to ``None`` = \"same as the gear\" (STplus manual §4.16.2: tool\nmodule and profile angle are entered only when they deviate from the gear). Other optional\nfields stay ``None`` when the tool does not define them; the generation module then applies the\nnorm default and reports it in ``warnings`` — never a silent fallback inside the model.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ToolKind",
          "default": "rack"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "STplus section name ($ WKZ_...)",
          "title": "Name"
        },
        "normal_module_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tool normal module",
          "designation": null,
          "designation_en": null,
          "factor": false,
          "location": null,
          "quantity": "tool_normal_module",
          "source": null,
          "status": "pending",
          "stplus_key": "WKZ_NORMALMODUL",
          "symbol": "m_n0",
          "title": "Normal Module Mm",
          "unit": "mm"
        },
        "profile_angle_deg": {
          "anyOf": [
            {
              "maximum": 30.0,
              "minimum": 10.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Profilwinkel des Bezugserzeugungsprofils",
          "designation": "Profilwinkel des Bezugserzeugungsprofils",
          "designation_en": null,
          "factor": false,
          "location": "§3.1 symbol list, p. 15",
          "quantity": "tool_profile_angle",
          "source": "ISO21771:2014",
          "status": "verified",
          "stplus_key": "WKZ_EINGRIFFSWINKEL",
          "symbol": "alpha_P0",
          "title": "Profile Angle Deg",
          "unit": "deg"
        },
        "addendum_factor": {
          "description": "addendum of tool (module factor)",
          "designation": "Kopfhöhe des Werkzeug-Bezugsprofils",
          "designation_en": "addendum of tool",
          "exclusiveMinimum": 0.0,
          "factor": true,
          "location": "§3.1 symbol list, p. 12; §7.5 Eq. (125), p. 68",
          "maximum": 2.5,
          "quantity": "tool_addendum",
          "source": "ISO21771:2014",
          "status": "verified",
          "stplus_key": "KOPFHOEHENFAKTOR",
          "symbol": "h_aP0*",
          "title": "Addendum Factor",
          "type": "number",
          "unit": "-"
        },
        "tip_radius_factor": {
          "description": "tool tip corner rounding (module factor)",
          "designation": "Kopfkantenrundungsradius des Werkzeug-Bezugsprofils",
          "designation_en": "tool tip corner rounding",
          "factor": true,
          "location": "§2 table, p. 1; §4.4 and §4.5 Anmerkung, p. 2",
          "maximum": 0.6,
          "minimum": 0.0,
          "quantity": "tool_tip_radius",
          "source": "DIN867:1986",
          "status": "verified",
          "stplus_key": "KOPFABRUNDUNGSFAKTOR",
          "symbol": "rho_aP0*",
          "title": "Tip Radius Factor",
          "type": "number",
          "unit": "-"
        },
        "dedendum_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 2.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fußhöhe des Werkzeug-Bezugsprofils (module factor)",
          "designation": "Fußhöhe des Werkzeug-Bezugsprofils",
          "designation_en": null,
          "factor": true,
          "location": "§3.1 symbol list, p. 12",
          "quantity": "tool_dedendum",
          "source": "ISO21771:2014",
          "status": "verified",
          "stplus_key": "FUSSHOEHENFAKTOR",
          "symbol": "h_fP0*",
          "title": "Dedendum Factor",
          "unit": "-"
        },
        "root_form_height_factor": {
          "anyOf": [
            {
              "maximum": 2.5,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tool root form height (module factor)",
          "designation": null,
          "designation_en": null,
          "factor": true,
          "location": null,
          "quantity": "tool_root_form_height",
          "source": null,
          "status": "pending",
          "stplus_key": "FUSSFORMHOEHENFAKTOR",
          "symbol": "h_FfP0*",
          "title": "Root Form Height Factor",
          "unit": "-"
        },
        "edge_break_angle_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 90.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tool edge break angle",
          "designation": null,
          "designation_en": null,
          "factor": false,
          "location": null,
          "quantity": "tool_edge_break_angle",
          "source": null,
          "status": "pending",
          "stplus_key": "KANTENBRECHWINKEL",
          "symbol": "alpha_KP",
          "title": "Edge Break Angle Deg",
          "unit": "deg"
        },
        "protuberance_mm": {
          "default": 0.0,
          "description": "tool protuberance",
          "designation": null,
          "designation_en": null,
          "factor": false,
          "location": null,
          "minimum": 0.0,
          "quantity": "tool_protuberance",
          "source": null,
          "status": "pending",
          "stplus_key": "PROTUBERANZBETRAG",
          "symbol": "pr",
          "title": "Protuberance Mm",
          "type": "number",
          "unit": "mm"
        },
        "protuberance_angle_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 90.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tool protuberance angle",
          "designation": null,
          "designation_en": null,
          "factor": false,
          "location": null,
          "quantity": "tool_protuberance_angle",
          "source": null,
          "status": "pending",
          "stplus_key": "PROTUBERANZWINKEL",
          "symbol": "alpha_pr",
          "title": "Protuberance Angle Deg",
          "unit": "deg"
        },
        "machining_allowance_mm": {
          "default": 0.0,
          "description": "Material allowance for finishing",
          "designation": "Bearbeitungszugabe auf der Zahnflanke",
          "designation_en": "Material allowance for finishing",
          "factor": false,
          "location": "§3.1 symbol list, p. 13; §7.1 Bild 36 b), p. 64",
          "minimum": 0.0,
          "quantity": "machining_allowance",
          "source": "ISO21771:2014",
          "status": "verified",
          "stplus_key": "BEARB_ZUGABE_WKZ",
          "symbol": "q",
          "title": "Machining Allowance Mm",
          "type": "number",
          "unit": "mm"
        }
      },
      "required": [
        "addendum_factor",
        "tip_radius_factor"
      ],
      "title": "ToolProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One gear of a pair. ``profile_shift_coefficient``, ``span`` or a_w with the mate's x fix x.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/GearKind",
      "default": "external"
    },
    "number_of_teeth": {
      "description": "number of teeth",
      "designation": "Zähnezahl",
      "designation_en": "number of teeth",
      "factor": false,
      "location": "§3.1 symbol list, p. 14",
      "maximum": 1000,
      "minimum": 5,
      "quantity": "number_of_teeth",
      "source": "ISO21771:2014",
      "status": "verified",
      "stplus_key": "ZAEHNEZAHL",
      "symbol": "z",
      "title": "Number Of Teeth",
      "type": "integer",
      "unit": "-"
    },
    "profile_shift_coefficient": {
      "anyOf": [
        {
          "maximum": 2.0,
          "minimum": -2.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "profile shift coefficient",
      "designation": "Profilverschiebungsfaktor",
      "designation_en": "profile shift coefficient",
      "factor": false,
      "location": "§3.1 symbol list, p. 13",
      "quantity": "profile_shift_coefficient",
      "source": "ISO21771:2014",
      "status": "verified",
      "stplus_key": "PROFILVERSCHIEBUNG_N",
      "symbol": "x",
      "title": "Profile Shift Coefficient",
      "unit": "-"
    },
    "span": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpanMeasurement"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "face_width_mm": {
      "description": "face width",
      "designation": "Zahnbreite",
      "designation_en": "face width",
      "exclusiveMinimum": 0.0,
      "factor": false,
      "location": "§3.1 symbol list, p. 11",
      "maximum": 2000.0,
      "quantity": "face_width",
      "source": "ISO21771:2014",
      "status": "verified",
      "stplus_key": "ZAHNBREITE",
      "symbol": "b",
      "title": "Face Width Mm",
      "type": "number",
      "unit": "mm"
    },
    "tip_diameter_mm": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "tip diameter",
      "designation": "Kopfkreisdurchmesser",
      "designation_en": "tip diameter",
      "factor": false,
      "location": "§3.1 symbol list, p. 11",
      "quantity": "tip_diameter",
      "source": "ISO21771:2014",
      "status": "verified",
      "stplus_key": "KOPFKREISDM",
      "symbol": "d_a",
      "title": "Tip Diameter Mm",
      "unit": "mm"
    },
    "tip_chamfer_radial_mm": {
      "default": 0.0,
      "description": "Tip chamfer",
      "designation": "Radiale Höhe des Kopfkantenbruchs oder der Kopfkantenrundung",
      "designation_en": "Tip chamfer",
      "factor": false,
      "location": "§3.1 symbol list, p. 12",
      "minimum": 0.0,
      "quantity": "tip_chamfer_radial",
      "source": "ISO21771:2014",
      "status": "verified",
      "stplus_key": "KOPFKANTENBRUCH",
      "symbol": "h_K",
      "title": "Tip Chamfer Radial Mm",
      "type": "number",
      "unit": "mm"
    },
    "tool": {
      "$ref": "#/$defs/ToolProfile"
    },
    "finishing_tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "material": {
      "anyOf": [
        {
          "$ref": "#/$defs/MaterialRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "number_of_teeth_spanned": {
      "anyOf": [
        {
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Number of teeth spanned",
      "designation": "Anzahl der Zähne, Lücken oder Teilungen in einem Bereich (z. B. Messzähnezahl)",
      "designation_en": "Number of teeth spanned",
      "factor": false,
      "location": "§3.1 symbol list, p. 12",
      "quantity": "number_of_teeth_spanned",
      "source": "ISO21771:2014",
      "status": "verified",
      "stplus_key": "MESSZAEHNEZAHL",
      "symbol": "k",
      "title": "Number Of Teeth Spanned",
      "unit": "-"
    },
    "tooth_thickness_allowance_um": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "tooth thickness allowance",
      "designation": null,
      "designation_en": null,
      "factor": false,
      "location": null,
      "quantity": "tooth_thickness_allowance",
      "source": null,
      "status": "pending",
      "symbol": "E_sns/E_sni",
      "title": "Tooth Thickness Allowance Um",
      "unit": "µm"
    },
    "span_allowance_um": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "span allowance",
      "designation": null,
      "designation_en": null,
      "factor": false,
      "location": null,
      "quantity": "span_allowance",
      "source": null,
      "status": "pending",
      "stplus_key": "OBERES_ZAHNW_ABMASS",
      "symbol": "A_We/A_Wi",
      "title": "Span Allowance Um",
      "unit": "µm"
    },
    "allowance_series": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ABMASS_TOL_REIHE — DIN 3967 designation such as 'C25' or 'cd25'",
      "title": "Allowance Series"
    },
    "quality_grade": {
      "anyOf": [
        {
          "maximum": 12,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "quality grade",
      "designation": null,
      "designation_en": null,
      "factor": false,
      "location": null,
      "quantity": "quality_grade",
      "source": null,
      "status": "pending",
      "stplus_key": "DIN_QUALITAET",
      "symbol": "Q",
      "title": "Quality Grade",
      "unit": "-"
    },
    "quality_system": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualitySystem"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "number_of_teeth",
    "face_width_mm",
    "tool"
  ],
  "title": "GearInput",
  "type": "object"
}
